export global ForgeTheme {
    in property <color> void: #07090b;
    in property <color> work: #0d1114;
    in property <color> rail: #171b1f;
    in property <color> raised: #1d2328;
    in property <color> chrome: #101418;
    in property <color> separator: #2c343b;
    in property <color> separator-strong: #46515b;
    in property <color> text: #edf1f4;
    in property <color> text-secondary: #aeb7be;
    in property <color> text-muted: #89959e;
    // #a47c5f against the darkest #07090b work surface exceeds 4.5:1,
    // preserving readable 11px unavailable-state labels without brightening
    // them into actionable emphasis.
    in property <color> unavailable-text: #a47c5f;
    in property <color> ember: #b7642e;
    in property <color> ember-hot: #df884a;
    in property <color> success: #72c78e;
    in property <color> danger: #ec7770;
}
