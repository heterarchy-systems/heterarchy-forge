import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { ForgeTheme } from "theme.slint";

export component ForgeButton inherits Rectangle {
    in property <string> label: "Action";
    in property <string> accessible-name: root.label;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> active: false;
    in property <bool> compact: false;
    callback activated();

    forward-focus: focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.activated(); }
    height: root.compact ? 30px : 34px;
    min-width: root.compact ? 52px : 72px;
    border-width: 1px;
    border-radius: 3px;
    border-color: focus.has-focus && root.enabled ? ForgeTheme.ember-hot :
                  !root.enabled ? ForgeTheme.separator :
                  root.danger ? #7f3a36 :
                  root.active ? ForgeTheme.ember : ForgeTheme.separator-strong;
    background: !root.enabled ? #121619 :
                touch.pressed ? (root.danger ? #4d2422 : #303840) :
                touch.has-hover ? (root.danger ? #3d211f : #242b31) :
                root.active ? #2a211a : ForgeTheme.raised;

    Text {
        text: root.label;
        color: !root.enabled ? #626d76 :
               root.danger ? #ffaaa0 :
               root.active ? #f4aa68 : ForgeTheme.text;
        font-size: root.compact ? 11px : 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
}

export component PaneChevron inherits Rectangle {
    in property <bool> points-right: true;
    in property <string> accessible-name: "Toggle pane";
    callback activated();

    height: 30px;
    min-width: 34px;
    border-width: 1px;
    border-radius: 3px;
    border-color: focus.has-focus ? ForgeTheme.ember-hot : ForgeTheme.separator-strong;
    background: touch.pressed ? #303840 : touch.has-hover ? #242b31 : ForgeTheme.raised;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.activated(); }
    forward-focus: focus;
    Path {
        x: (parent.width - 12px) / 2;
        y: (parent.height - 14px) / 2;
        width: 12px;
        height: 14px;
        viewbox-width: 12;
        viewbox-height: 14;
        commands: root.points-right ? "M 3 2 L 9 7 L 3 12" : "M 9 2 L 3 7 L 9 12";
        fill: transparent;
        stroke: ForgeTheme.text-secondary;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    touch := TouchArea { clicked => { root.activated(); } }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
}

// Exact causal edge geometry. The caller supplies coordinates projected from
// the validated durable revision; this component has no authoring callback.
export component DagEdgeConnector inherits Rectangle {
    in property <length> from-y: 0px;
    in property <length> to-y: 0px;
    in property <bool> blocked: false;
    in property <bool> current-path: false;
    in property <string> accessible-name: "Dependency edge";

    private property <length> upper-y: min(root.from-y, root.to-y);
    private property <length> from-offset: root.from-y - root.upper-y;
    private property <length> to-offset: root.to-y - root.upper-y;
    private property <length> elbow-x: root.width / 2;
    private property <color> line-color: root.blocked ? ForgeTheme.unavailable-text :
                                          root.current-path ? ForgeTheme.ember-hot : ForgeTheme.separator-strong;
    height: max(2px, max(root.from-y, root.to-y) - root.upper-y + 2px);
    background: transparent;
    accessible-role: text;
    accessible-label: root.accessible-name;
    Rectangle {
        x: 0px;
        y: root.from-offset;
        width: root.elbow-x;
        height: root.current-path ? 2px : 1px;
        background: root.line-color;
    }
    Rectangle {
        x: root.elbow-x;
        y: min(root.from-offset, root.to-offset);
        width: root.current-path ? 2px : 1px;
        height: max(1px, max(root.from-offset, root.to-offset) - min(root.from-offset, root.to-offset));
        background: root.line-color;
    }
    Rectangle {
        x: root.elbow-x;
        y: root.to-offset;
        width: root.width - root.elbow-x;
        height: root.current-path ? 2px : 1px;
        background: root.line-color;
    }
    if root.blocked : Text {
        x: root.elbow-x + 4px;
        y: max(0px, root.to-offset - 13px);
        text: "BLOCKED";
        color: ForgeTheme.unavailable-text;
        font-size: 10px;
        font-weight: 700;
    }
}

export component PaneHeader inherits Rectangle {
    in property <string> label: "SECTION";
    in property <string> detail: "";
    height: 34px;
    background: #171b1f;
    border-color: ForgeTheme.separator;
    border-width: 1px;
    HorizontalBox {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.label;
            color: ForgeTheme.text-secondary;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.detail;
            color: ForgeTheme.text-muted;
            font-family: "monospace";
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component EmptyState inherits Rectangle {
    in property <string> title: "No data";
    in property <string> detail: "";
    in property <string> workflow-hint: "";
    in property <string> action-label: "";
    callback action();
    background: ForgeTheme.void;
    VerticalBox {
        alignment: start;
        padding: 18px;
        spacing: 9px;
        Rectangle { width: 42px; height: 2px; background: ForgeTheme.ember; }
        Text {
            text: root.title;
            color: ForgeTheme.text;
            font-size: 15px;
            font-weight: 700;
        }
        Text {
            text: root.detail;
            color: ForgeTheme.text-secondary;
            font-size: 12px;
            wrap: word-wrap;
        }
        if root.workflow-hint != "" : Rectangle {
            height: 34px;
            background: ForgeTheme.chrome;
            border-color: ForgeTheme.separator;
            border-width: 1px;
            Text {
                x: 10px;
                width: parent.width - 20px;
                text: root.workflow-hint;
                color: ForgeTheme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.action-label != "" : ForgeButton {
            label: root.action-label;
            accessible-name: root.action-label;
            activated => { root.action(); }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

export component PaneSplitter inherits TouchArea {
    in property <string> label: "Resize pane";
    in property <length> current-width: 0px;
    in property <bool> reverse: false;
    callback requested(length);

    private property <length> drag-start-width: 0px;
    private property <length> drag-start-x: 0px;
    changed pressed => {
        if root.pressed {
            root.drag-start-width = root.current-width;
            root.drag-start-x = root.mouse-x;
        }
    }
    moved => {
        if root.pressed {
            root.requested(root.drag-start-width + (root.reverse ? root.drag-start-x - root.mouse-x : root.mouse-x - root.drag-start-x));
        }
    }

    width: 7px;
    mouse-cursor: ew-resize;
    forward-focus: focus;
    accessible-role: slider;
    accessible-label: root.label;
    Rectangle {
        x: 3px;
        width: focus.has-focus || root.pressed || root.has-hover ? 2px : 1px;
        height: 100%;
        background: focus.has-focus ? ForgeTheme.ember-hot :
                    root.pressed || root.has-hover ? #52606a : ForgeTheme.separator;
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.requested(root.current-width + (root.reverse ? 8px : -8px));
                return accept;
            }
            if event.text == Key.RightArrow {
                root.requested(root.current-width + (root.reverse ? -8px : 8px));
                return accept;
            }
            return reject;
        }
    }
}

export component ContextField inherits Rectangle {
    in property <string> label: "FIELD";
    in property <string> value: "Unavailable";
    in property <bool> warning: false;
    in property <length> value-min-width: 0px;
    accessible-role: text;
    accessible-label: root.label + " " + root.value;
    height: 38px;
    background: transparent;
    HorizontalBox {
        height: 100%;
        spacing: 6px;
        Text {
            text: root.label;
            color: ForgeTheme.text-muted;
            font-size: 10px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            min-width: root.value-min-width;
            color: root.warning ? #d99a60 : ForgeTheme.text-secondary;
            font-family: root.label == "PATH" || root.label == "UPTIME" ? "monospace" : "system-ui";
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

export component FlatRow inherits Rectangle {
    in property <string> title: "Row";
    in property <string> detail: "";
    in property <string> state: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback activated();

    height: 58px;
    border-width: focus.has-focus || root.selected ? 1px : 0px;
    border-color: focus.has-focus ? ForgeTheme.ember-hot :
                  root.selected ? ForgeTheme.ember : ForgeTheme.separator;
    background: touch.pressed ? #242b31 :
                touch.has-hover ? #1d2328 :
                root.selected ? #211b17 : ForgeTheme.work;
    accessible-role: list-item;
    accessible-enabled: root.enabled;
    accessible-label: root.title + " " + root.state + " " + root.detail;
    accessible-action-default => { root.activated(); }
    forward-focus: focus;
    VerticalBox {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 7px;
        padding-bottom: 6px;
        spacing: 3px;
        HorizontalBox {
            spacing: 8px;
            Text { text: root.title; color: ForgeTheme.text; font-size: 12px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
            Text { text: root.state; color: root.selected ? #f4aa68 : ForgeTheme.text-secondary; font-size: 10px; font-weight: 600; }
        }
        Text { text: root.detail; color: ForgeTheme.text-muted; font-size: 12px; overflow: elide; }
    }
    Rectangle { x: 0px; y: root.height - 1px; width: 100%; height: 1px; background: ForgeTheme.separator; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
    focus := FocusScope {
        x: 0px; width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.activated(); return accept; }
            return reject;
        }
    }
}

// A bounded, operator-safe projection of one durable DAG node. This is a
// selection surface only: no graph editing gestures or mutation callbacks
// belong in the Slint layer.
export component DagNodeCard inherits Rectangle {
    in property <string> node-id: "";
    in property <string> label: "Node";
    in property <string> state: "PENDING";
    in property <string> objective: "";
    in property <string> acceptance: "";
    in property <string> depends-on: "";
    in property <string> waiting-on: "";
    in property <string> evidence: "";
    in property <string> revision: "";
    in property <bool> current: false;
    in property <bool> terminal: false;
    in property <bool> selected: false;
    callback activated();

    private property <bool> failure-state: root.state == "FAILED" || root.state == "CANCELLED";
    private property <bool> verified-state: root.state == "COMPLETED" || root.state == "READY";

    height: 164px;
    border-width: 1px;
    border-radius: 2px;
    border-color: focus.has-focus ? ForgeTheme.ember-hot :
                  root.selected || root.current ? ForgeTheme.ember :
                  root.failure-state ? #7f3a36 : ForgeTheme.separator-strong;
    background: touch.pressed ? #242b31 :
                touch.has-hover ? #1d2328 :
                root.selected ? #211b17 : ForgeTheme.work;
    accessible-role: list-item;
    accessible-label: root.label + ", " + root.state +
                      (root.current ? ", current node" : "") +
                      ", objective " + root.objective +
                      ", acceptance " + root.acceptance +
                      ", depends on " + (root.depends-on == "" ? "none" : root.depends-on) +
                      ", waiting on " + (root.waiting-on == "" ? "nothing" : root.waiting-on) +
                      ", evidence " + (root.evidence == "" ? "none" : root.evidence) +
                      ", revision " + root.revision;
    accessible-action-default => { root.activated(); }
    forward-focus: focus;

    VerticalBox {
        padding: 9px;
        spacing: 5px;
        HorizontalBox {
            spacing: 8px;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 6px;
                border-width: root.current ? 2px : 1px;
                border-color: root.current ? ForgeTheme.ember-hot :
                              root.failure-state ? ForgeTheme.danger :
                              root.verified-state ? ForgeTheme.success : ForgeTheme.text-muted;
                background: root.current ? ForgeTheme.ember : ForgeTheme.void;
            }
            Text {
                text: root.label;
                color: ForgeTheme.text;
                font-size: 12px;
                font-weight: 700;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.current ? "CURRENT · " + root.state : root.terminal ? root.state + " · TERMINAL" : root.state;
                color: root.failure-state ? ForgeTheme.danger :
                       root.verified-state ? ForgeTheme.success :
                       root.current ? ForgeTheme.ember-hot : ForgeTheme.text-secondary;
                font-size: 10px;
                font-weight: 700;
            }
        }
        Text {
            text: root.objective == "" ? "No objective projection" : root.objective;
            color: root.objective == "" ? ForgeTheme.text-muted : ForgeTheme.text-secondary;
            font-size: 11px;
            overflow: elide;
        }
        Text {
            text: "ACCEPT · " + (root.acceptance == "" ? "Not projected" : root.acceptance);
            color: ForgeTheme.text-muted;
            font-size: 10px;
            overflow: elide;
        }
        Rectangle { height: 1px; background: ForgeTheme.separator; }
        Text {
            text: "DEPENDS · " + (root.depends-on == "" ? "ROOT" : root.depends-on);
            color: ForgeTheme.text-secondary;
            font-family: "monospace";
            font-size: 10px;
            overflow: elide;
        }
        Text {
            text: "WAITING · " + (root.waiting-on == "" ? "NONE" : root.waiting-on);
            color: root.waiting-on == "" ? ForgeTheme.text-muted : #d99a60;
            font-family: "monospace";
            font-size: 10px;
            overflow: elide;
        }
        HorizontalBox {
            spacing: 8px;
            Text {
                text: "EVIDENCE · " + (root.evidence == "" ? "NONE" : root.evidence);
                color: root.evidence == "" ? ForgeTheme.text-muted : ForgeTheme.text-secondary;
                font-family: "monospace";
                font-size: 10px;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: "REV " + root.revision;
                color: ForgeTheme.text-muted;
                font-family: "monospace";
                font-size: 10px;
            }
        }
    }

    touch := TouchArea { clicked => { root.activated(); } }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
}

export component SettingsRow inherits Rectangle {
    in property <string> title: "Setting";
    in property <string> detail: "";
    in property <string> value: "";
    in property <bool> unavailable: false;
    height: 64px;
    background: ForgeTheme.work;
    border-width: 0px;
    HorizontalBox {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;
        VerticalBox {
            vertical-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: root.title; color: root.unavailable ? ForgeTheme.text-muted : ForgeTheme.text; font-size: 13px; font-weight: 600; }
            Text { text: root.detail; color: ForgeTheme.text-muted; font-size: 12px; overflow: elide; }
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.value;
            color: root.unavailable ? ForgeTheme.unavailable-text : ForgeTheme.text-secondary;
            font-family: "monospace";
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    Rectangle { x: 0px; y: root.height - 1px; width: 100%; height: 1px; background: ForgeTheme.separator; }
}
