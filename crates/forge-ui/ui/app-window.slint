// THESIS: One durable Workspace authority frames every observable action.
// OWN-WORLD: Obsidian Assay Bench; blackened steel, graphite rails, rare ember.
// STORY: Navigate scope left, examine causal work center, verify evidence right.
// FIRST VIEWPORT: Path, Harness, runtime, Goal, DAG, Activity, and Safety answer
// what owns the work, what is active, what happened, and what can be stopped.
// FORM: Dense flat panes, hairline structure, explicit state, no dashboard cards.
// FINISH: unreviewed and undocumented is unfinished; this build ends with the
// finish review, the verdict, and DESIGN.md.

import { AboutSlint, HorizontalBox, LineEdit, ListView, Palette, TextEdit, VerticalBox } from "std-widgets.slint";
import { ForgeButton, PaneChevron, PaneHeader, EmptyState, PaneSplitter, ContextField, FlatRow, DagNodeCard, DagEdgeConnector, SettingsRow } from "components.slint";
import { ReferenceWorkbench } from "reference-workbench.slint";
import { ForgeTheme } from "theme.slint";
import { LocationRow, WorkspaceRow, McpTokenRow, AgentRow, ActivityRow, DiffRow, ApprovalRow, GoalRow, DagNodeRow, DagEdgeRow, WorkNarrativeRow, HarnessRow, DoctorFindingRow } from "models.slint";

export { LocationRow, WorkspaceRow, McpTokenRow, AgentRow, ActivityRow, DiffRow, ApprovalRow, GoalRow, DagNodeRow, DagEdgeRow, WorkNarrativeRow, HarnessRow, DoctorFindingRow } from "models.slint";

export component AboutWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: "About Heterarchy Forge";
    preferred-width: 420px;
    preferred-height: 320px;
    min-width: 360px;
    min-height: 260px;
    background: ForgeTheme.work;
    VerticalBox {
        padding: 24px;
        spacing: 14px;
        Text { text: "HETERARCHY FORGE"; color: ForgeTheme.text; font-size: 22px; font-weight: 700; letter-spacing: 1.5px; horizontal-alignment: center; }
        Text { text: "A deliberate local runtime for explicit Workspaces."; color: ForgeTheme.text-secondary; font-size: 12px; horizontal-alignment: center; }
        Rectangle { vertical-stretch: 1; background: #12161a; border-color: ForgeTheme.separator; border-width: 1px; AboutSlint { horizontal-stretch: 1; vertical-stretch: 1; } }
        ForgeButton { label: "Close"; activated => { root.close(); } }
    }
}

export component AppWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: "Heterarchy Forge";
    preferred-width: 1480px;
    preferred-height: 920px;
    min-width: 1120px;
    min-height: 720px;
    background: ForgeTheme.void;

    in property <string> runtime-status: "Starting";
    in property <string> runtime-detail: "Booting background runtime";
    in property <string> application-support-path: "";
    in property <int> runtime-generation: 0;
    in property <int> uptime-seconds: 0;
    in property <[LocationRow]> location-rows: [];
