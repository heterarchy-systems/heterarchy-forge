    in-out property <string> dag-revision: "";
    in-out property <string> dag-head-revision: "";
    // The native host may bind this to the platform's Reduce Motion setting.
    // Rust shortens the same bounded transition to an opacity-only cut when
    // this is true; keeping the switch explicit avoids hidden animation policy.
    in-out property <bool> dag-reduced-motion: false;
    in property <string> work-narrative-status: "No operator-safe work narrative has been published.";
    in property <string> harness-status: "확정된 Workspace를 선택하면 하네스 상태를 볼 수 있습니다.";
    in property <string> applied-harness-name: "Not connected";
    in property <string> applied-harness-version: "";
    in property <string> applied-harness-source: "";
    in property <string> applied-harness-hash: "";
    in property <string> applied-harness-verification: "UNVERIFIED";
    in property <string> applied-harness-verified-at: "";
    in-out property <bool> show-live-activities: true;
    // Raw widths are session-local operator intent. Responsive calculations
    // clamp only the effective projection and never rewrite these values.
    in-out property <length> left-rail-width: 260px;
    in-out property <length> right-rail-width: 320px;
    in-out property <bool> left-rail-collapsed: false;
    in-out property <bool> right-rail-collapsed: false;
    in-out property <bool> settings-open: false;
    in-out property <int> settings-section: 0;
    in-out property <bool> evidence-open: false;
    // Session-local visual navigation only. Domain semantics continue to come
    // from the Rust-owned projections and callbacks below.
    in-out property <int> active-page: 0;
    in-out property <bool> workspace-view-open: false;
    in-out property <bool> goal-compose-open: false;
    in-out property <string> goal-objective-input: "";
    in-out property <string> goal-success-criterion-input: "";
    in-out property <string> inspector-title: "전체 작업";
    in-out property <string> inspector-kind: "OVERVIEW";
    in-out property <string> inspector-detail: "아직 공개된 구조화 작업 설명이 없습니다.";
    in-out property <string> inspector-evidence: "Goal 또는 DAG 단계를 선택하면 관측 가능한 진행을 볼 수 있습니다.";

    private property <bool> minimum-layout: root.width < 1280px;
    private property <bool> wide-layout: root.width >= 1600px;
    private property <length> center-minimum: root.wide-layout ? 720px : root.minimum-layout ? 570px : 620px;
    private property <length> left-minimum: root.wide-layout ? 300px : root.minimum-layout ? 236px : 260px;
    private property <length> left-maximum: root.wide-layout ? 420px : root.minimum-layout ? 300px : 360px;
    private property <length> right-minimum: root.wide-layout ? 380px : root.minimum-layout ? 300px : 320px;
    private property <length> right-maximum: root.wide-layout ? 520px : root.minimum-layout ? 360px : 440px;
    private property <length> left-candidate: root.left-rail-collapsed ? 48px : max(root.left-minimum, min(root.left-maximum, root.left-rail-width));
    private property <length> right-budget: max(root.right-minimum, root.width - root.left-candidate - root.center-minimum - 14px);
    private property <length> effective-right-width: root.right-rail-collapsed ? 48px : max(root.right-minimum, min(root.right-maximum, min(root.right-rail-width, root.right-budget)));
    private property <length> left-budget: max(root.left-minimum, root.width - root.effective-right-width - root.center-minimum - 14px);
    private property <length> effective-left-width: root.left-rail-collapsed ? 48px : max(root.left-minimum, min(root.left-maximum, min(root.left-rail-width, root.left-budget)));
    // The tab is the only session UI authority for Inspector content. Safety
    // is tab 4 and Doctor is tab 5; no parallel boolean can drift from this selection.
    private property <int> inspector-tab: 0;
    private property <length> dag-node-width: root.minimum-layout ? 210px : root.wide-layout ? 260px : 232px;
    private property <length> dag-node-height: 164px;
    private property <length> dag-column-gap: root.minimum-layout ? 58px : 72px;
    private property <length> dag-lane-gap: 18px;
    private property <string> selected-activity-label: root.selected-activity-id == "" ? "선택한 Activity 없음" : "Activity 선택됨";
    in-out property <string> selected-goal-id: "";
    in-out property <string> selected-goal-revision: "";
    in-out property <string> selected-goal-state: "";
    in-out property <string> selected-goal-objective: "";
    in-out property <string> selected-goal-success-criterion: "";
    in-out property <string> selected-goal-check-summary: "";
    in-out property <string> selected-goal-evidence-summary: "";
    in-out property <string> selected-goal-blocker: "";
    in-out property <bool> selected-goal-terminal: false;
    in-out property <bool> selected-goal-can-pause: false;
    in-out property <bool> selected-goal-can-resume: false;
    in-out property <bool> selected-goal-can-cancel: false;
    in-out property <bool> selected-goal-can-complete: false;
    in-out property <string> selected-dag-id: "";
    private property <string> selected-dag-label: "";
    private property <string> selected-dag-state: "";
    private property <string> selected-dag-state-label: "";
    private property <string> selected-dag-objective: "";
    private property <string> selected-dag-acceptance: "";
    private property <string> selected-dag-depends-on: "";
    private property <string> selected-dag-waiting-on: "";
    private property <string> selected-dag-evidence: "";
    private property <string> selected-dag-revision: "";
    in-out property <string> selected-dag-agent-name: "";
    in-out property <string> selected-dag-work-summary: "";
    in-out property <string> selected-dag-public-summary: "";
    in-out property <string> selected-dag-last-observed: "";
    private property <bool> selected-dag-current: false;
    private property <bool> selected-dag-terminal: false;
    private property <string> selected-diff-id: "";

    changed selected-workspace-id => {
        // Clear the previous Workspace's durable descendant projection in the
        // same UI turn. The Rust projection pump may repopulate only after it
        // has resolved and revalidated the newly selected Workspace.
        root.dag-node-rows = [];
        root.dag-edge-rows = [];
        root.dag-column-count = 0;
        root.dag-lane-count = 0;
        root.dag-revision = "";
        root.dag-head-revision = "";
        root.dag-status = root.selected-workspace-id == "" ?
                          "Select a Workspace and Goal to inspect a Chat-authored DAG." :
                          "선택한 Workspace의 durable DAG를 불러오는 중…";
        root.inspector-tab = 0;
        root.selected-activity-label = "선택한 Activity 없음";
        root.selected-goal-id = "";
        root.selected-goal-revision = "";
        root.selected-goal-state = "";
        root.selected-goal-objective = "";
        root.selected-goal-success-criterion = "";
        root.selected-goal-check-summary = "";
        root.selected-goal-evidence-summary = "";
        root.selected-goal-blocker = "";
        root.selected-goal-terminal = false;
        root.selected-goal-can-pause = false;
        root.selected-goal-can-resume = false;
        root.selected-goal-can-cancel = false;
        root.selected-goal-can-complete = false;
        root.goal-compose-open = false;
        root.goal-objective-input = "";
        root.goal-success-criterion-input = "";
        root.selected-dag-id = "";
        root.selected-dag-label = "";
        root.selected-dag-state = "";
        root.selected-dag-state-label = "";
        root.selected-dag-objective = "";
        root.selected-dag-acceptance = "";
        root.selected-dag-depends-on = "";
        root.selected-dag-waiting-on = "";
        root.selected-dag-evidence = "";
        root.selected-dag-revision = "";
        root.selected-dag-agent-name = "";
        root.selected-dag-work-summary = "";
        root.selected-dag-public-summary = "";
        root.selected-dag-last-observed = "";
        root.selected-dag-agent-name = "";
        root.selected-dag-work-summary = "";
        root.selected-dag-public-summary = "";
        root.selected-dag-last-observed = "";
        root.selected-dag-current = false;
        root.selected-dag-terminal = false;
        root.selected-diff-id = "";
        root.inspector-kind = "OVERVIEW";
        root.inspector-title = root.selected-workspace-id == "" ? "선택한 Workspace 없음" : "Workspace 요약";
        root.inspector-detail = root.selected-workspace-id == "" ? "Workspace를 선택하면 durable 작업을 볼 수 있습니다." : root.selected-workspace-root;
        root.inspector-evidence = "Runtime " + root.runtime-status + " · live " + root.activity-live-rows.length + " · history " + root.activity-history-rows.length + " · approvals " + root.approval-rows.length;
        root.selected-mcp-token-index = -1;
        root.mcp-token-review-mode = "";
        root.mcp-token-reveal = "";
        root.mcp-token-reveal-status = "";
        root.selected-agent-id = "";
        root.selected-agent-name = "";
        root.selected-agent-role = "";
        root.selected-agent-state = "";
        root.selected-agent-liveness = "";
        root.selected-agent-current-goal = "";
        root.selected-agent-current-node = "";
        root.selected-agent-public-summary = "";
        root.selected-agent-evidence = "";
        root.selected-agent-last-observed = "";
        root.agent-dag-grant-id = "";
        root.agent-dag-grant-goal-id = "";
        root.agent-dag-grant-status = "Goal과 DAG를 선택하면 이 Agent에게 5분간 한 번의 재계획 권한을 줄 수 있습니다.";
        root.agent-dag-grant-availability = "없음";
        root.agent-dag-grant-active = false;
    }
    changed selected-activity-id => {
        if root.selected-activity-id != "" {
            root.selected-goal-id = "";
            root.selected-dag-id = "";
            root.selected-diff-id = "";
        }
    }
    changed selected-goal-id => {
        // Re-discover only the grant bound to the newly selected exact Goal
        // and DAG head. This keeps the Agent inspector truthful after the
        // operator moves between Goals without exposing unrelated grants.
        if root.selected-workspace-id != "" && root.selected-goal-id != "" && root.selected-agent-id != "" {
            root.select-agent(root.selected-agent-id);
        }
    }
    changed goal-rows => {
        if root.goal-rows.length == 0 {
            root.dag-node-rows = [];
            root.dag-edge-rows = [];
            root.dag-column-count = 0;
            root.dag-lane-count = 0;
            root.dag-revision = "";
            root.selected-goal-id = "";
            root.selected-goal-revision = "";
            root.selected-goal-state = "";
            root.selected-goal-objective = "";
            root.selected-goal-success-criterion = "";
            root.selected-goal-check-summary = "";
            root.selected-goal-evidence-summary = "";
            root.selected-goal-blocker = "";
            root.selected-goal-terminal = false;
            root.selected-goal-can-pause = false;
            root.selected-goal-can-resume = false;
            root.selected-goal-can-cancel = false;
            root.selected-goal-can-complete = false;
        }
    }
    callback start-runtime(); callback stop-runtime(); callback restart-runtime(); callback quit-application();
    callback add-location(string); callback open-workspace-folder(); callback refresh-locations(); callback discover-location(string, string); callback select-workspace(int);
    callback refresh-doctor();
    callback export-doctor-diagnostics();
    callback refresh-activities(); callback select-activity(string); callback view-diff(string); callback close-diff-view();
    callback create-goal(string, string); callback refresh-goals(); callback select-goal(string);
    callback select-dag-node(string);
    callback select-agent(string);
    callback select-agent-work-for-node(string);
    callback issue-agent-dag-grant(string, string, string, string, string);
    callback revoke-agent-dag-grant();
    callback pause-goal(string, string); callback resume-goal(string, string);
    callback cancel-goal(string, string); callback complete-goal(string, string);
    callback refresh-approvals(); callback approve-request(string); callback reject-request(string); callback set-auto-approval(bool);
    callback stop-workspace-work(); callback emergency-stop();
    callback register-harness(); callback refresh-harnesses();
    callback refresh-harness(string, string);
    callback register-harness-skill(); callback refresh-harness-skills();
    callback refresh-harness-skill(int);
    callback select-harness-composition-base(int);
    callback toggle-harness-composition-skill(int);
    callback save-harness-composition(string, string);
    callback preview-harness(string, string);
    callback apply-harness-preview();
    callback preview-harness-lifecycle(string, string);
    callback preview-harness-remove();
    callback apply-harness-lifecycle();
    callback run-harness-verifiers();
    callback refresh-harness-verifiers();
    callback verify-applied-harness();
    callback save-mcp-connection(string, string);
    callback refresh-mcp-connection();
    callback start-mcp-server();
    callback stop-mcp-server();
    callback issue-mcp-token(string);
    callback rotate-mcp-token(int);
    callback revoke-mcp-token(int);
    callback dismiss-mcp-token-reveal();

    Rectangle {
        width: 100%;
        height: 100%;
        // Reference-driven workbench is now the sole visible AppWindow composition.
        // Rust-owned projections and callbacks above remain the authority boundary.
        // legacy composition while the migration is verified so that every
        // Rust callback/property contract remains intact. Once parity is
        // proven, the covered legacy layout can be removed without changing
        // the worker/control boundary.
        reference-workbench := ReferenceWorkbench {
            x: 0px; y: 0px; width: 100%; height: 100%;
            active-page <=> root.active-page;
            workspace-view-open <=> root.workspace-view-open;
            runtime-status: root.runtime-status;
            runtime-detail: root.runtime-detail;
            runtime-generation: root.runtime-generation;
            uptime-seconds: root.uptime-seconds;

            workspace-rows: root.workspace-rows;
            selected-workspace-index: root.selected-workspace-index;
            selected-workspace-id: root.selected-workspace-id;
            selected-workspace-root: root.selected-workspace-root;
            selected-workspace-revision: root.selected-workspace-revision;
            workspace-status: root.workspace-status;
            location-name-input <=> root.location-name-input;
            folder-picker-open: root.folder-picker-open;
            location-action-busy: root.location-action-busy;

            agent-rows: root.agent-rows;
            selected-agent-id: root.selected-agent-id;
            selected-agent-name: root.selected-agent-name;
            selected-agent-role: root.selected-agent-role;
            selected-agent-state: root.selected-agent-state;
            selected-agent-liveness: root.selected-agent-liveness;
            selected-agent-current-goal: root.selected-agent-current-goal;
            selected-agent-current-node: root.selected-agent-current-node;
            selected-agent-public-summary: root.selected-agent-public-summary;
            selected-agent-evidence: root.selected-agent-evidence;
            selected-agent-last-observed: root.selected-agent-last-observed;
            agent-action-busy: root.agent-action-busy;

            goal-rows: root.goal-rows;
            goal-status: root.goal-status;
            goal-action-busy: root.goal-action-busy;
            goal-objective-input <=> root.goal-objective-input;
            goal-success-criterion-input <=> root.goal-success-criterion-input;
            selected-goal-id: root.selected-goal-id;
            selected-goal-revision: root.selected-goal-revision;
            selected-goal-state: root.selected-goal-state;
            selected-goal-objective: root.selected-goal-objective;
            selected-goal-success-criterion: root.selected-goal-success-criterion;
            selected-goal-check-summary: root.selected-goal-check-summary;
            selected-goal-evidence-summary: root.selected-goal-evidence-summary;
            selected-goal-blocker: root.selected-goal-blocker;
            selected-goal-terminal: root.selected-goal-terminal;
            selected-goal-can-pause: root.selected-goal-can-pause;
            selected-goal-can-resume: root.selected-goal-can-resume;
            selected-goal-can-cancel: root.selected-goal-can-cancel;
            selected-goal-can-complete: root.selected-goal-can-complete;

            dag-node-rows: root.dag-node-rows;
            dag-edge-rows: root.dag-edge-rows;
            dag-column-count: root.dag-column-count;
            dag-lane-count: root.dag-lane-count;
            dag-revision: root.dag-revision;
            dag-head-revision: root.dag-head-revision;
            dag-status: root.dag-status;
            selected-dag-id: root.selected-dag-id;
            selected-dag-agent-name: root.selected-dag-agent-name;
            selected-dag-work-summary: root.selected-dag-work-summary;
            selected-dag-public-summary: root.selected-dag-public-summary;
            selected-dag-last-observed: root.selected-dag-last-observed;

            activity-live-rows: root.activity-live-rows;
            activity-history-rows: root.activity-history-rows;
            activity-status: root.activity-status;
            selected-activity-id: root.selected-activity-id;
            work-narrative-rows: root.work-narrative-rows;
            diff-rows: root.diff-rows;
            diff-status: root.diff-status;
            diff-view-open: root.diff-view-open;
            diff-view-title: root.diff-view-title;
            diff-view-content: root.diff-view-content;

            harness-rows: root.harness-rows;
            harness-skill-rows: root.harness-skill-rows;
            harness-preview-rows: root.harness-preview-rows;
            harness-lifecycle-rows: root.harness-lifecycle-rows;
            harness-verifier-rows: root.harness-verifier-rows;
            harness-library-status: root.harness-library-status;
            harness-skill-status: root.harness-skill-status;
            harness-composition-status: root.harness-composition-status;
            harness-composition-base-name: root.harness-composition-base-name;
            harness-composition-base-index: root.harness-composition-base-index;
            harness-composition-selected-skill-count: root.harness-composition-selected-skill-count;
            harness-composition-name-input <=> root.harness-composition-name-input;
            harness-composition-version-input <=> root.harness-composition-version-input;
            harness-preview-status: root.harness-preview-status;
            harness-lifecycle-status: root.harness-lifecycle-status;
            harness-lifecycle-mode: root.harness-lifecycle-mode;
            harness-verifier-status: root.harness-verifier-status;
            harness-preview-applyable: root.harness-preview-applyable;
            harness-lifecycle-applyable: root.harness-lifecycle-applyable;
            harness-action-busy: root.harness-action-busy;
            harness-status: root.harness-status;
            applied-harness-name: root.applied-harness-name;
            applied-harness-version: root.applied-harness-version;
            applied-harness-source: root.applied-harness-source;
            applied-harness-hash: root.applied-harness-hash;
            applied-harness-verification: root.applied-harness-verification;
            applied-harness-verified-at: root.applied-harness-verified-at;

            mcp-public-origin-input <=> root.mcp-public-origin-input;
            mcp-local-port-input <=> root.mcp-local-port-input;
            mcp-credential-label-input <=> root.mcp-credential-label-input;
            mcp-public-endpoint: root.mcp-public-endpoint;
            mcp-local-endpoint: root.mcp-local-endpoint;
            mcp-connection-status: root.mcp-connection-status;
            mcp-server-status: root.mcp-server-status;
            mcp-server-detail: root.mcp-server-detail;
            mcp-public-route-status: root.mcp-public-route-status;
            mcp-server-running: root.mcp-server-running;
            mcp-action-busy: root.mcp-action-busy;
            mcp-token-rows: root.mcp-token-rows;
            mcp-active-token-count: root.mcp-active-token-count;
            mcp-token-reveal: root.mcp-token-reveal;
            mcp-token-reveal-status: root.mcp-token-reveal-status;

            approval-rows: root.approval-rows;
            approval-status: root.approval-status;
            approval-action-busy: root.approval-action-busy;
            auto-approval-enabled: root.auto-approval-enabled;
            doctor-finding-rows: root.doctor-finding-rows;
            doctor-status: root.doctor-status;
            doctor-summary: root.doctor-summary;
            doctor-export-content: root.doctor-export-content;
            doctor-action-busy: root.doctor-action-busy;

            add-location(name) => { root.add-location(name); }
            open-workspace-folder => { root.open-workspace-folder(); }
            refresh-locations => { root.refresh-locations(); }
            select-workspace(index) => { root.select-workspace(index); }
            select-agent(index) => {
                if index >= 0 && index < root.agent-rows.length {
                    root.selected-agent-id = root.agent-rows[index].id;
                    root.selected-agent-name = root.agent-rows[index].display-name;
                    root.selected-agent-role = root.agent-rows[index].role;
                    root.selected-agent-state = root.agent-rows[index].state;
                    root.selected-agent-liveness = root.agent-rows[index].liveness;
                    root.selected-agent-current-goal = root.agent-rows[index].current-goal;
                    root.selected-agent-current-node = root.agent-rows[index].current-node;
                    root.selected-agent-public-summary = root.agent-rows[index].public-summary;
                    root.selected-agent-evidence = root.agent-rows[index].evidence;
                    root.selected-agent-last-observed = root.agent-rows[index].last-observed;
                    root.select-agent(root.agent-rows[index].id);
                }
            }
            agent-dag-grant-id: root.agent-dag-grant-id;
            agent-dag-grant-goal-id: root.agent-dag-grant-goal-id;
            agent-dag-grant-status: root.agent-dag-grant-status;
            agent-dag-grant-availability: root.agent-dag-grant-availability;
            agent-dag-grant-active: root.agent-dag-grant-active;
            issue-agent-dag-grant(agent-id, goal-id, goal-revision, dag-revision, dag-head-revision) => {
                root.issue-agent-dag-grant(agent-id, goal-id, goal-revision, dag-revision, dag-head-revision);
            }
            revoke-agent-dag-grant => { root.revoke-agent-dag-grant(); }
            select-goal(index) => {
                if index >= 0 && index < root.goal-rows.length {
                    root.dag-node-rows = [];
                    root.dag-edge-rows = [];
                    root.dag-column-count = 0;
                    root.dag-lane-count = 0;
                    root.dag-revision = "";
                    root.selected-goal-id = root.goal-rows[index].id;
                    root.selected-goal-revision = root.goal-rows[index].revision;
                    root.selected-goal-state = root.goal-rows[index].state;
                    root.selected-goal-objective = root.goal-rows[index].objective;
                    root.selected-goal-success-criterion = root.goal-rows[index].success-criterion;
                    root.selected-goal-check-summary = root.goal-rows[index].check-summary;
                    root.selected-goal-evidence-summary = root.goal-rows[index].evidence-summary;
                    root.selected-goal-blocker = root.goal-rows[index].blocker;
                    root.selected-goal-terminal = root.goal-rows[index].terminal;
                    root.selected-goal-can-pause = root.goal-rows[index].can-pause;
                    root.selected-goal-can-resume = root.goal-rows[index].can-resume;
                    root.selected-goal-can-cancel = root.goal-rows[index].can-cancel;
                    root.selected-goal-can-complete = root.goal-rows[index].can-complete;
                    root.selected-dag-id = "";
                    root.select-goal(root.goal-rows[index].id);
                }
            }
            select-dag-node(index) => {
                if index >= 0 && index < root.dag-node-rows.length {
                    root.selected-agent-id = "";
                    root.selected-dag-id = root.dag-node-rows[index].id;
                    root.selected-dag-label = root.dag-node-rows[index].label;
                    root.selected-dag-state = root.dag-node-rows[index].state;
                    root.selected-dag-state-label = root.dag-node-rows[index].state-label;
                    root.selected-dag-objective = root.dag-node-rows[index].objective;
                    root.selected-dag-acceptance = root.dag-node-rows[index].acceptance;
                    root.selected-dag-depends-on = root.dag-node-rows[index].depends-on;
                    root.selected-dag-waiting-on = root.dag-node-rows[index].waiting-on;
                    root.selected-dag-evidence = root.dag-node-rows[index].evidence;
                    root.selected-dag-revision = root.dag-node-rows[index].revision;
                    root.selected-dag-agent-name = "";
                    root.selected-dag-work-summary = "";
                    root.selected-dag-public-summary = "";
                    root.selected-dag-last-observed = "";
                    root.selected-dag-current = root.dag-node-rows[index].current;
                    root.selected-dag-terminal = root.dag-node-rows[index].terminal;
                    root.select-dag-node(root.dag-node-rows[index].id);
                    root.select-agent-work-for-node(root.dag-node-rows[index].id);
                }
            }
            create-goal(objective, criterion) => { root.create-goal(objective, criterion); }
            refresh-goals => { root.refresh-goals(); }
            pause-goal => { root.pause-goal(root.selected-goal-id, root.selected-goal-revision); }
            resume-goal => { root.resume-goal(root.selected-goal-id, root.selected-goal-revision); }
            cancel-goal => { root.cancel-goal(root.selected-goal-id, root.selected-goal-revision); }
            complete-goal => { root.complete-goal(root.selected-goal-id, root.selected-goal-revision); }
            register-harness => { root.register-harness(); }
            refresh-harnesses => { root.refresh-harnesses(); }
            refresh-harness(index) => {
                if index >= 0 && index < root.harness-rows.length {
                    root.refresh-harness(root.harness-rows[index].machine-id, root.harness-rows[index].revision);
                }
            }
            select-harness-base(index) => { root.select-harness-composition-base(index); }
            toggle-harness-skill(index) => { root.toggle-harness-composition-skill(index); }
            register-harness-skill => { root.register-harness-skill(); }
            refresh-harness-skills => { root.refresh-harness-skills(); }
            refresh-harness-skill(index) => { root.refresh-harness-skill(index); }
            save-harness-composition(name, version) => { root.save-harness-composition(name, version); }
            preview-harness(index) => {
                if index >= 0 && index < root.harness-rows.length {
                    root.preview-harness(root.harness-rows[index].machine-id, root.harness-rows[index].revision);
                }
            }
            apply-harness-preview => { root.apply-harness-preview(); }
            preview-harness-lifecycle(index) => {
                if index >= 0 && index < root.harness-rows.length {
                    root.preview-harness-lifecycle(root.harness-rows[index].machine-id, root.harness-rows[index].revision);
                }
            }
            preview-harness-remove => { root.preview-harness-remove(); }
            apply-harness-lifecycle => { root.apply-harness-lifecycle(); }
            run-harness-verifiers => { root.run-harness-verifiers(); }
            refresh-harness-verifiers => { root.refresh-harness-verifiers(); }
            verify-applied-harness => { root.verify-applied-harness(); }
            save-mcp-connection(origin, port) => { root.save-mcp-connection(origin, port); }
            refresh-mcp-connection => { root.refresh-mcp-connection(); }
            start-mcp-server => { root.start-mcp-server(); }
            stop-mcp-server => { root.stop-mcp-server(); }
            issue-mcp-token(label) => { root.issue-mcp-token(label); }
            rotate-mcp-token(index) => { root.rotate-mcp-token(index); }
            revoke-mcp-token(index) => { root.revoke-mcp-token(index); }
            dismiss-mcp-token-reveal => { root.dismiss-mcp-token-reveal(); }
            refresh-activities => { root.refresh-activities(); }
            select-activity(id) => { root.select-activity(id); }
            view-diff(id) => { root.view-diff(id); }
            close-diff-view => { root.close-diff-view(); }
            refresh-approvals => { root.refresh-approvals(); }
            approve-request(id) => { root.approve-request(id); }
            reject-request(id) => { root.reject-request(id); }
            set-auto-approval(enabled) => { root.set-auto-approval(enabled); }
            stop-workspace-work => { root.stop-workspace-work(); }
            emergency-stop => { root.emergency-stop(); }
            start-runtime => { root.start-runtime(); }
            stop-runtime => { root.stop-runtime(); }
            restart-runtime => { root.restart-runtime(); }
            refresh-doctor => { root.refresh-doctor(); }
            export-doctor-diagnostics => { root.export-doctor-diagnostics(); }
        }
    }
}

export component ForgeTray inherits SystemTrayIcon {
    icon: @image-url("../../../docs/assets/hf-image.png");
    title: "Forge";
    tooltip: "Heterarchy Forge · " + root.runtime-status;
    in property <string> runtime-status: "Starting";
    in property <int> pending-approval-count: 0;
    in property <bool> auto-approval-enabled: false;
    in property <bool> workspace-selected: false;
    callback open-window(); callback open-about(); callback start-runtime(); callback stop-runtime(); callback restart-runtime(); callback open-approvals(); callback set-auto-approval(bool); callback stop-workspace-work(); callback emergency-stop(); callback quit-application();
    Menu {
        MenuItem { title: "About Heterarchy Forge"; activated => { root.open-about(); } }
        MenuSeparator { }
        MenuItem { title: "Pending Approvals · " + root.pending-approval-count; activated => { root.open-approvals(); } }
        MenuItem { title: root.auto-approval-enabled ? "Disable Auto Approval" : "Enable Auto Approval"; activated => { root.set-auto-approval(!root.auto-approval-enabled); } }
        MenuItem { title: "Stop Workspace Work"; enabled: root.workspace-selected; activated => { root.stop-workspace-work(); } }
        MenuItem { title: "Emergency Stop"; enabled: root.runtime-status != "Stopped"; activated => { root.emergency-stop(); } }
        MenuSeparator { }
        MenuItem { title: "Open Heterarchy Forge"; activated => { root.open-window(); } }
        MenuItem { title: "Runtime · " + root.runtime-status; enabled: false; }
        MenuItem { title: "Start Runtime"; enabled: root.runtime-status == "Stopped"; activated => { root.start-runtime(); } }
        MenuItem { title: "Stop Runtime"; enabled: root.runtime-status == "Running"; activated => { root.stop-runtime(); } }
        MenuItem { title: "Restart Runtime"; enabled: root.runtime-status == "Running"; activated => { root.restart-runtime(); } }
        MenuSeparator { }
        MenuItem { title: "Quit Heterarchy Forge"; activated => { root.quit-application(); } }
    }
}
