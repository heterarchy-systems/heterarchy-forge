    in property <string> approval-status: "확정된 Workspace를 선택하면 승인 요청을 볼 수 있습니다.";
    in property <int> selected-workspace-index: -1;
    in property <string> selected-workspace-id: "";
    in property <string> selected-workspace-revision: "";
    in property <string> selected-workspace-root: "";
    in-out property <string> selected-agent-id: "";
    in-out property <string> selected-agent-name: "";
    in-out property <string> selected-agent-role: "";
    in-out property <string> selected-agent-state: "";
    in-out property <string> selected-agent-liveness: "";
    in-out property <string> selected-agent-current-goal: "";
