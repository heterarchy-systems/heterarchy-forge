    in property <bool> agent-action-busy: false;
    in property <int> mcp-active-token-count: 0;
    in-out property <int> selected-mcp-token-index: -1;
    in-out property <string> mcp-token-review-mode: "";
    in-out property <string> mcp-token-reveal: "";
    in-out property <string> mcp-token-reveal-status: "";
    in property <string> goal-status: "Goal이 없어도 Activity는 유효합니다.";
